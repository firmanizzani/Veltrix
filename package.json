{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc --noEmit && vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write resources/js resources/css app database routes tests \"bootstrap/*.php\" config package.json vite.config.js tsconfig.json components.json",
        "format:check": "prettier --check resources/js resources/css app database routes tests \"bootstrap/*.php\" config package.json vite.config.js tsconfig.json components.json"
    },
    "dependencies": {
        "@fontsource-variable/inter": "latest",
        "@inertiajs/react": "^3.0.0",
        "@radix-ui/react-dialog": "latest",
        "@radix-ui/react-slot": "latest",
        "class-variance-authority": "latest",
        "clsx": "latest",
        "lucide-react": "latest",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "recharts": "latest",
        "sonner": "latest",
        "tailwind-merge": "latest"
    },
    "devDependencies": {
        "@prettier/plugin-php": "^0.26.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "latest",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "latest",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
